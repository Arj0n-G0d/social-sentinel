NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-local-password
NEO4J_DATABASE=neo4j
# mock is explicitly a fixture replay, NOT an LLM prediction.
LLM_PROVIDER=mock
# To use Gemini, set LLM_PROVIDER=gemini and supply your API key.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
ANALYSIS_VERSION=v1
LLM_TIMEOUT=45

# Read-only Reddit OAuth application credentials, used by scripts.poll_social.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:social-sentinel:0.1 (by /u/YOUR_USERNAME)

# Read-only X API v2 access.
X_BEARER_TOKEN=
