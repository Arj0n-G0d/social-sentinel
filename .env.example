NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-local-password
NEO4J_DATABASE=neo4j
# Optional authenticated graph search (use an app password).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# mock is explicitly a fixture replay, NOT an LLM prediction.
LLM_PROVIDER=mock
# To use Gemini, set LLM_PROVIDER=gemini and supply your API key.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
ANALYSIS_VERSION=v1
LLM_TIMEOUT=45
